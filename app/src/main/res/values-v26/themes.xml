<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Material 3 Expressive) - API 26+ overrides -->
    <style name="Theme.SagerNet" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="actionBarStyle">@style/Widget.Material3.ActionBar.Solid</item>
        <item name="actionModeCloseDrawable">@drawable/ic_navigation_close</item>
        <item name="colorButtonNormal">?colorPrimary</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/material_pink_500</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/material_pink_100</item>
        <item name="colorOnPrimaryContainer">@color/material_pink_900</item>
        <item name="colorPrimaryDark">@color/material_pink_700</item>
        <item name="colorAccent">@color/material_pink_accent_200</item>
        <item name="colorSecondary">@color/material_pink_500</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/material_pink_100</item>
        <item name="colorOnSecondaryContainer">@color/material_pink_900</item>
        <item name="colorTertiary">@color/material_purple_accent_200</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/material_purple_100</item>
        <item name="colorOnTertiaryContainer">@color/material_purple_900</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceVariant">@color/material_pink_100</item>
        <item name="colorOnSurfaceVariant">@color/material_pink_300</item>
        <item name="colorOutline">@color/material_pink_300</item>
        <item name="colorError">@color/material_red_accent_200</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="colorOnBackground">@color/black</item>
        <item name="colorMaterial100">@color/material_pink_100</item>
        <item name="colorMaterial300">@color/material_pink_300</item>
        <item name="accentOrTextSecondary">?colorAccent</item>
        <item name="accentOrTextPrimary">?colorAccent</item>
        <item name="primaryOrTextSecondary">?colorPrimary</item>
        <item name="primaryOrTextPrimary">?colorPrimary</item>
        <item name="fabColorBackground">?colorPrimary</item>
        <item name="selectedColorPrimary">?colorPrimary</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="tabTextColor">#99FFFFFF</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabIndicatorColor">@color/white</item>
        <item name="tabRippleColor">@color/white</item>
        <item name="whiteOrTextPrimary">@color/white</item>
        <item name="windowActionModeOverlay">true</item>
        <!-- Remove ActionBar but keep styles and themes -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="chipStyle">@style/Widget.Material3.Chip.Choice.SagerNet</item>
        <item name="itemShapeAppearance">
            @style/ShapeAppearance.Material3.MediumComponent
        </item>
        <item name="alertDialogTheme">
            @style/ThemeOverlay.Material3.MaterialAlertDialog.SagerNet
        </item>
        <item name="materialAlertDialogTheme">
            @style/ThemeOverlay.Material3.MaterialAlertDialog.SagerNet
        </item>
    </style>
</resources>
