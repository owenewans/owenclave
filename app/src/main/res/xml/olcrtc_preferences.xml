    <io.nekohasekai.sagernet.widget.NonBlackEditTextPreference
        app:icon="@drawable/ic_maps_directions_boat"
        app:key="serverOlcrtcSocksHost"
        app:title="@string/olcrtc_socks_host"
        app:useSimpleSummaryProvider="true" />
    <EditTextPreference
        app:icon="@drawable/ic_maps_directions_boat"
        app:key="serverOlcrtcSocksPort"
        app:title="@string/olcrtc_socks_port"
        app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
</PreferenceScreen>
