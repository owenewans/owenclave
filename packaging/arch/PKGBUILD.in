# Template used by bin/desktop/arch/package.sh: @PKGVER@ and @PKGDESC@ are filled
# in from version.properties before makepkg runs.
pkgname=owenclave-desktop
pkgver=@PKGVER@
pkgrel=1
pkgdesc="@PKGDESC@"
arch=('x86_64' 'aarch64')
url="https://github.com/owenewans/owenclave"
license=('GPL-3.0-only')
depends=()
provides=('owenclave')
conflicts=('owenclave')
options=('!strip' '!debug' '!emptydirs')
install=owenclave.install

# The application image built by jpackage, already containing its own runtime, the
# proxy core, NaiveProxy and tun2socks, so no system JRE is required.
source=("owenclave-desktop-$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  install -dm755 "$pkgdir/opt/owenclave"
  cp -a "$srcdir/opt/owenclave/." "$pkgdir/opt/owenclave/"
  chmod 755 "$pkgdir/opt/owenclave/bin/owenclave-tun-helper"
  [ -f "$pkgdir/opt/owenclave/bin/tun2socks" ] && chmod 755 "$pkgdir/opt/owenclave/bin/tun2socks"

  install -dm755 "$pkgdir/usr/bin"
  cat >"$pkgdir/usr/bin/owenclave" <<'EOF'
#!/usr/bin/env sh
if [ -z "${_JAVA_AWT_WM_NONREPARENTING+x}" ]; then
  case ":${XDG_CURRENT_DESKTOP:-}:${XDG_SESSION_DESKTOP:-}:${DESKTOP_SESSION:-}:" in
    *[Nn]iri*|*[Hh]yprland*|*[Ss]way*|*[Rr]iver*|*[Cc]osmic*|*[Ll]abwc*|*[Ww]ayfire*|*wlroots*|*dwl*|*jay*|*scroll*|*i3*|*bspwm*|*dwm*|*awesome*|*qtile*|*xmonad*|*leftwm*|*herbstluftwm*)
      export _JAVA_AWT_WM_NONREPARENTING=1
      ;;
  esac
fi
exec /opt/owenclave/bin/Owenclave "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/owenclave"

  install -Dm644 "$srcdir/owenclave.desktop" "$pkgdir/usr/share/applications/owenclave.desktop"
  install -Dm644 "$srcdir/owenclave.png" "$pkgdir/usr/share/pixmaps/owenclave.png"
  install -Dm644 "$srcdir/org.owenewans.owenclave.policy" \
    "$pkgdir/usr/share/polkit-1/actions/org.owenewans.owenclave.policy"
}
